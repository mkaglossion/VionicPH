px solid #8FA19A;\n        }\n\n        .footer-section input[type=\"email\"] {\n            padding: 10px;\n            border: none;\n            flex: 1;\n            font-size: 14px;\n            color: #333;\n        }\n\n        .footer-section button {\n            padding: 10px 20px;\n            background-color: #8FA19A;\n            color: #fff;\n            border: none;\n            cursor: pointer;\n            font-size: 14px;\n        }\n\n        .footer-section .social-icons {\n            display: flex;\n            align-items: center;\n            margin-top: 10px;\n        }\n\n        .footer-section .social-icons a {\n            margin-right: 10px;\n        }\n\n        .footer-section .social-icons img {\n            width: 24px;\n            height: 24px;\n        }\n\n        .footer .vertical-line {\n            width: 1px;\n            background-color: #fff;\n            margin: 0 20px;\n        }\n\n        \/* Mobile footer styling *\/\n        .mobile-footer {\n            display: none;\n        }\n\n        @media (max-width: 768px) {\n            .footer {\n                display: none;\n            }\n\n            .mobile-footer {\n                display: block;\n                text-align: center;\n                padding: 20px;\n                background-color: #333;\n                color: #fff;\n                font-family: Arial, sans-serif;\n            }\n\n            .mobile-footer h2 {\n                font-size: 18px;\n                margin-bottom: 5px;\n                color: #fff;\n            }\n\n            .mobile-footer p {\n                font-size: 14px;\n                margin: 5px 0;\n                color: #fff;\n            }\n\n            .mobile-footer p.phone-number {\n                font-size: 16px;\n                font-weight: bold;\n            }\n\n            .mobile-footer p.operating-hours {\n                font-size: 15px;\n                margin-top: 5px;\n                margin-bott