<!-- grid-banner-3.liquid -->
{% assign gb3_placeholder_bg = section.settings.placeholder_bg %}
{% if gb3_placeholder_bg == blank or gb3_placeholder_bg == 'rgba(0,0,0,0)' or gb3_placeholder_bg == 'transparent' %}
  {% assign gb3_placeholder_bg = '#8f949c' %}
{% endif %}
{% assign gb3_card_title_size = section.settings.card_title_size | plus: 0 %}
{% if gb3_card_title_size < 18 %}
  {% assign gb3_card_title_size = 18 %}
{% endif %}
{% assign gb3_card_title_size_mobile = section.settings.card_title_size_mobile | plus: 0 %}
{% if gb3_card_title_size_mobile < 16 %}
  {% assign gb3_card_title_size_mobile = 16 %}
{% endif %}
{% assign gb3_card_variant_size = section.settings.card_variant_size | plus: 0 %}
{% if gb3_card_variant_size < 12 %}
  {% assign gb3_card_variant_size = 12 %}
{% endif %}
{% assign gb3_card_variant_size_mobile = section.settings.card_variant_size_mobile | plus: 0 %}
{% if gb3_card_variant_size_mobile < 11 %}
  {% assign gb3_card_variant_size_mobile = 11 %}
{% endif %}
{% assign gb3_card_price_size = section.settings.card_price_size | plus: 0 %}
{% if gb3_card_price_size < 15 %}
  {% assign gb3_card_price_size = 15 %}
{% endif %}
{% assign gb3_card_price_size_mobile = section.settings.card_price_size_mobile | plus: 0 %}
{% if gb3_card_price_size_mobile < 14 %}
  {% assign gb3_card_price_size_mobile = 14 %}
{% endif %}
<style>
  .gb3-{{ section.id }} {
    padding: {{ section.settings.paddingsection }};
    margin: {{ section.settings.marginsection }};
    background: #ffffff;
  }

  .gb3-{{ section.id }} .gb3-container.full {
    width: 100%;
    max-width: 100%;
    padding-left: 0;
    padding-right: 0;
  }

  .gb3-{{ section.id }} .gb3-heading {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 24px;
  }

  .gb3-{{ section.id }} .gb3-heading-left {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: 1;
    min-width: 0;
  }

  .gb3-{{ section.id }} .gb3-heading-title {
    margin: 0;
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 400;
    line-height: 1;
    letter-spacing: .04em;
    text-transform: uppercase;
    color: {{ section.settings.heading_color }};
    white-space: nowrap;
  }

  .gb3-{{ section.id }} .gb3-heading-line {
    flex: 1;
    height: 1px;
    background: {{ section.settings.heading_line_color }};
  }

  .gb3-{{ section.id }} .gb3-collection-actions {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    margin: 18px 0 12px;
  }

  .gb3-{{ section.id }} .gb3-view-all {
    color: {{ section.settings.heading_color }};
    font-size: 12px;
    font-weight: 600;
    letter-spacing: .08em;
    text-decoration: none;
    text-transform: uppercase;
    border-bottom: 1px solid currentColor;
    padding-bottom: 3px;
    white-space: nowrap;
  }

  .gb3-{{ section.id }} .gb3-view-all:hover {
    opacity: .75;
    text-decoration: none;
  }

  .gb3-{{ section.id }} .gb3-banner {
    position: relative;
    display: block;
    width: 100%;
    height: {{ section.settings.banner_height }}px;
    overflow: hidden;
    text-decoration: none;
    background: {{ gb3_placeholder_bg }};
    border-radius: 0;
  }

  .gb3-{{ section.id }} .gb3-banner.gb3-banner--adapt {
    height: auto;
    background: transparent;
  }

  .gb3-{{ section.id }} .gb3-banner-media,
  .gb3-{{ section.id }} .gb3-banner-media img {
    width: 100%;
    height: 100%;
  }

  .gb3-{{ section.id }} .gb3-banner-media .desktop-img,
  .gb3-{{ section.id }} .gb3-banner-media .mobile-img {
    object-fit: cover;
    display: block;
  }

  .gb3-{{ section.id }} .gb3-banner.gb3-banner--adapt .gb3-banner-media,
  .gb3-{{ section.id }} .gb3-banner.gb3-banner--adapt .gb3-banner-media img {
    height: auto;
  }

  .gb3-{{ section.id }} .gb3-banner.gb3-banner--adapt .gb3-banner-media .desktop-img,
  .gb3-{{ section.id }} .gb3-banner.gb3-banner--adapt .gb3-banner-media .mobile-img {
    object-fit: contain;
  }

  .gb3-{{ section.id }} .gb3-banner-media .mobile-img {
    display: none;
  }

  .gb3-{{ section.id }} .gb3-banner-placeholder {
    position: absolute;
    inset: 0;
    background: {{ gb3_placeholder_bg }};
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 20px;
    color: #ffffff;
  }

  .gb3-{{ section.id }} .gb3-banner-placeholder-inner {
    max-width: 520px;
    margin: 0 auto;
  }

  .gb3-{{ section.id }} .gb3-banner-placeholder svg {
    width: clamp(110px, 14vw, 170px);
    height: clamp(110px, 14vw, 170px);
    opacity: .8;
    margin-bottom: 28px;
  }

  .gb3-{{ section.id }} .gb3-banner-placeholder .gb3-title,
  .gb3-{{ section.id }} .gb3-banner-placeholder .gb3-desc,
  .gb3-{{ section.id }} .gb3-banner-placeholder .gb3-btn {
    color: #ffffff;
  }

  .gb3-{{ section.id }} .gb3-banner-placeholder .gb3-title {
    text-transform: none;
  }

  .gb3-{{ section.id }} .gb3-banner-placeholder .gb3-btn {
    border-bottom-color: #ffffff;
  }

  .gb3-{{ section.id }} .gb3-overlay {
    position: absolute;
    inset: 0;
    background: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity }};
    z-index: 1;
  }

  .gb3-{{ section.id }} .gb3-banner-caption {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: {{ section.settings.text_color }};
    padding: 20px;
  }

  .gb3-{{ section.id }} .gb3-title {
    margin: 0 0 12px;
    font-size: {{ section.settings.title_size }}px;
    font-weight: 600;
    line-height: 1.2;
    color: {{ section.settings.text_color }};
    text-transform: uppercase;
    letter-spacing: .02em;
  }

  .gb3-{{ section.id }} .gb3-desc {
    margin: 0 0 22px;
    font-size: {{ section.settings.desc_size }}px;
    font-weight: 600;
    color: {{ section.settings.text_color }};
  }

  .gb3-{{ section.id }} .gb3-btn {
    display: inline-block;
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.button_size }}px;
    font-weight: 600;
    line-height: 1;
    border-bottom: 2px solid {{ section.settings.text_color }};
    padding-bottom: 6px;
  }

  .gb3-{{ section.id }} .gb3-products-grid {
    display: grid;
    gap: {{ section.settings.gap }}px;
    margin-top: 0;
  }

  .gb3-{{ section.id }} .gb3-products-slider {
    display: none;
    margin-top: 0;
  }

  .gb3-{{ section.id }} .gb3-products-slider .swiper-slide {
    height: auto;
  }

  .gb3-{{ section.id }} .gb3-product-card {
    display: block;
    text-decoration: none;
    color: #1f1f1f;
  }

  .gb3-{{ section.id }} .gb3-product-media {
    position: relative;
    width: 100%;
    height: {{ section.settings.card_height }}px;
    border-radius: {{ section.settings.item_border_radius }}px;
    overflow: hidden;
    background: transparent;
  }

  .gb3-{{ section.id }} .gb3-product-image-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .gb3-{{ section.id }} .gb3-product-media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    display: block;
  }

  .gb3-{{ section.id }} .gb3-product-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 3;
    display: inline-block;
    padding: 4px 10px;
    min-height: 24px;
    border-radius: 2px;
    font-size: {{ section.settings.card_badge_size }}px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: .01em;
    text-transform: none;
  }

  .gb3-{{ section.id }} .gb3-product-badge--sale {
    background: #6f7480;
    color: #ffffff;
  }

  .gb3-{{ section.id }} .gb3-product-badge--new {
    background: #efefef;
    color: #222;
  }

  .gb3-{{ section.id }} .gb3-product-wishlist {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.92);
    appearance: none;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #222;
    cursor: pointer;
    opacity: 1;
    transform: none;
    transition: opacity .2s ease, transform .2s ease, background-color .2s ease;
    box-shadow: 0 4px 14px rgba(0,0,0,.08);
    font-size: 0;
    line-height: 1;
    z-index: 2;
  }

  .gb3-{{ section.id }} .gb3-product-wishlist svg {
    width: 18px;
    height: 18px;
    fill: none;
  }

  .gb3-{{ section.id }} .gb3-product-wishlist:hover {
    background: #fff;
  }

  .gb3-{{ section.id }} .gb3-product-meta {
    text-align: center;
    margin-top: 16px;
    padding: 0 8px;
  }

  .gb3-{{ section.id }} .gb3-product-title {
    margin: 0;
    display: block;
    width: 100%;
    max-width: 100%;
    font-size: {{ gb3_card_title_size }}px;
    font-weight: 400;
    line-height: 1.2;
    color: #222;
    text-transform: uppercase;
    letter-spacing: 0;
    white-space: normal;
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .gb3-{{ section.id }} .gb3-product-title a {
    display: block;
    width: 100%;
    max-width: 100%;
    color: inherit;
    text-decoration: none;
  }

  .gb3-{{ section.id }} .gb3-product-variant {
    margin-top: 6px;
    font-size: {{ gb3_card_variant_size }}px;
    font-weight: 400;
    line-height: 1.25;
    color: #222;
    text-transform: uppercase;
    letter-spacing: .06em;
  }

  .gb3-{{ section.id }} .gb3-product-price {
    margin-top: 2px;
    font-size: {{ gb3_card_price_size }}px;
    line-height: 1.35;
    color: #222;
    font-weight: 400;
    letter-spacing: .01em;
  }

  .gb3-{{ section.id }} .gb3-product-thumb-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 10px;
  }

  .gb3-{{ section.id }} .gb3-product-thumb {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    cursor: pointer;
  }

  .gb3-{{ section.id }} .gb3-product-thumb img {
    width: 24px;
    height: 24px;
    object-fit: contain;
    display: block;
    transition: transform .18s ease, opacity .18s ease, filter .18s ease;
  }

  .gb3-{{ section.id }} .gb3-product-thumb:hover img {
    transform: scale(1.08);
    opacity: .95;
    filter: saturate(1.05);
  }

  .gb3-{{ section.id }} .gb3-product-thumb-label {
    display: none;
  }

  .gb3-{{ section.id }} .gb3-products-slider.swiper {
    position: relative;
    width: 100%;
    overflow: hidden;
    padding-bottom: 26px;
  }

  .gb3-{{ section.id }} .gb3-pagination {
    display: none;
    position: relative;
    margin-top: 8px;
    text-align: center;
  }

  .gb3-{{ section.id }} .gb3-pagination .swiper-pagination-bullet {
    width: 7px;
    height: 7px;
    margin: 0 4px;
    background: #c8c1b9;
    opacity: 1;
  }

  .gb3-{{ section.id }} .gb3-pagination .swiper-pagination-bullet-active {
    background: #222;
  }

  .gb3-{{ section.id }} .swiper-button-prev,
  .gb3-{{ section.id }} .swiper-button-next {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(0,0,0,0.5);
  }

  .gb3-{{ section.id }} .swiper-button-prev:after,
  .gb3-{{ section.id }} .swiper-button-next:after {
    font-size: 16px;
    color: #fff;
  }

  @media (max-width: 767px) {
    .gb3-{{ section.id }} {
      padding: {{ section.settings.paddingmobile }} !important;
      margin: {{ section.settings.marginmobile }} !important;
    }

    .gb3-{{ section.id }} .gb3-heading {
      margin-bottom: 18px;
      flex-wrap: wrap;
      justify-content: center;
      text-align: center;
    }

    .gb3-{{ section.id }} .gb3-heading-left {
      width: 100%;
      justify-content: center;
    }

    .gb3-{{ section.id }} .gb3-heading-line {
      display: none;
    }

    .gb3-{{ section.id }} .gb3-heading-title {
      font-size: 18px;
      white-space: normal;
    }

    .gb3-{{ section.id }} .gb3-collection-actions {
      justify-content: center;
      margin: 14px 0 10px;
    }

    .gb3-{{ section.id }} .gb3-banner {
      height: {{ section.settings.banner_height_mobile }}px;
    }

    .gb3-{{ section.id }} .gb3-banner.gb3-banner--adapt {
      height: auto !important;
    }

    .gb3-{{ section.id }} .gb3-banner-media .desktop-img {
      display: none;
    }

    .gb3-{{ section.id }} .gb3-banner-media .mobile-img {
      display: block;
    }

    .gb3-{{ section.id }}.gb3-mobile-carousel-enabled .gb3-products-grid {
      display: none;
    }

    .gb3-{{ section.id }}.gb3-mobile-carousel-enabled .gb3-products-slider {
      display: block;
      margin-top: 0;
    }

    .gb3-{{ section.id }}.gb3-mobile-carousel-enabled .gb3-pagination {
      display: block;
    }

    .gb3-{{ section.id }}:not(.gb3-mobile-carousel-enabled) .gb3-products-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: {{ section.settings.gap_mobile }}px;
    }

    .gb3-{{ section.id }} .gb3-products-slider .gb3-product-media {
      height: {{ section.settings.card_height_mobile }}px;
    }

    .gb3-{{ section.id }} .gb3-product-price {
      font-size: {{ section.settings.card_price_size_mobile }}px;
    }

    .gb3-{{ section.id }} .gb3-product-wishlist {
      top: 8px;
      right: 8px;
      width: 32px;
      height: 32px;
      opacity: 1;
      transform: none;
    }

    .gb3-{{ section.id }} .gb3-product-wishlist svg {
      width: 16px;
      height: 16px;
    }

    .gb3-{{ section.id }} .gb3-product-meta {
      margin-top: 14px;
      padding: 0 6px;
    }

    .gb3-{{ section.id }} .gb3-product-title {
      font-size: {{ gb3_card_title_size_mobile }}px;
      line-height: 1.2;
    }

    .gb3-{{ section.id }} .gb3-product-variant {
      font-size: {{ gb3_card_variant_size_mobile }}px;
    }

    .gb3-{{ section.id }} .gb3-product-price {
      font-size: {{ gb3_card_price_size_mobile }}px;
    }

    .gb3-{{ section.id }} .gb3-product-badge {
      top: 8px;
      left: 8px;
      padding: 3px 8px;
      min-height: 20px;
      font-size: {{ section.settings.card_badge_size_mobile }}px;
    }

    .gb3-{{ section.id }} .gb3-product-thumb-wrap {
      margin-top: 8px;
    }

    .gb3-{{ section.id }} .gb3-product-thumb,
    .gb3-{{ section.id }} .gb3-product-thumb img {
      width: 20px;
      height: 20px;
    }
  }

  @media (hover: none) {
    .gb3-{{ section.id }} .gb3-product-wishlist {
      opacity: 1;
      transform: none;
    }
  }
</style>

{% assign gb3_mobile_carousel_enabled = false %}
{% assign gb3_cards_collection_obj = blank %}
{% assign gb3_cards_per_view_desktop = section.settings.collection_cards_limit | default: 4 | at_least: 1 | at_most: 4 %}
{% assign gb3_cards_limit = 0 %}
{% assign gb3_rendered_cards_count = 0 %}
{% if section.settings.cards_collection != blank %}
  {% assign gb3_cards_collection_obj = collections[section.settings.cards_collection] %}
  {% if gb3_cards_collection_obj != blank and gb3_cards_collection_obj.products_count > 0 %}
    {% assign gb3_cards_limit = gb3_cards_collection_obj.products_count | at_most: gb3_cards_per_view_desktop %}
    {% assign gb3_rendered_cards_count = gb3_cards_limit %}
    {% if section.settings.enable_mobile_carousel and gb3_rendered_cards_count > 1 %}
      {% assign gb3_mobile_carousel_enabled = true %}
    {% endif %}
  {% endif %}
{% endif %}

<section class="gb3-{{ section.id }}{% if gb3_mobile_carousel_enabled %} gb3-mobile-carousel-enabled{% endif %}" data-aos="{{ section.settings.animation }}">
  <div class="gb3-container {{ section.settings.setwidth }}">
    {% assign has_banner_image = false %}
    {% if section.settings.banner_image != blank or section.settings.banner_image_mobile != blank %}
      {% assign has_banner_image = true %}
    {% endif %}
    {% assign desktop_banner_image = section.settings.banner_image | default: section.settings.banner_image_mobile %}
    {% assign mobile_banner_image = section.settings.banner_image_mobile | default: section.settings.banner_image %}
    {% assign cards_collection_obj = blank %}
    {% assign cards_per_view_desktop = section.settings.collection_cards_limit | default: 4 | at_least: 1 | at_most: 4 %}
    {% assign cards_limit = 0 %}
    {% assign rendered_cards_count = 0 %}
    {% assign use_collection = false %}
    {% if section.settings.cards_collection != blank %}
      {% assign cards_collection_obj = collections[section.settings.cards_collection] %}
      {% if cards_collection_obj != blank and cards_collection_obj.products_count > 0 %}
        {% assign use_collection = true %}
        {% assign cards_limit = cards_collection_obj.products_count | at_most: cards_per_view_desktop %}
        {% assign rendered_cards_count = cards_limit %}
      {% endif %}
    {% endif %}

    {% if section.settings.heading != blank or use_collection %}
      <div class="gb3-heading">
        <div class="gb3-heading-left">
          {% if section.settings.heading != blank %}
            <h2 class="gb3-heading-title">{{ section.settings.heading }}</h2>
          {% endif %}
          <span class="gb3-heading-line"></span>
        </div>
      </div>
    {% endif %}

    <a
      href="{{ section.settings.banner_link | default: '#' }}"
      class="gb3-banner{% if has_banner_image and section.settings.banner_height_mode == 'adapt' %} gb3-banner--adapt{% endif %}"
    >
      {% if has_banner_image %}
        <div class="gb3-banner-media">
          {% if desktop_banner_image != blank %}
            <img
              class="desktop-img"
              src="{{ desktop_banner_image | image_url: width: 1920 }}"
              alt="{{ desktop_banner_image.alt | default: section.settings.banner_title | escape }}"
              width="{{ desktop_banner_image.width }}"
              height="{{ desktop_banner_image.height }}"
              loading="lazy"
            >
          {% endif %}
          {% if mobile_banner_image != blank %}
            <img
              class="mobile-img"
              src="{{ mobile_banner_image | image_url: width: 1200 }}"
              alt="{{ mobile_banner_image.alt | default: section.settings.banner_title | escape }}"
              width="{{ mobile_banner_image.width }}"
              height="{{ mobile_banner_image.height }}"
              loading="lazy"
            >
          {% endif %}
        </div>
      {% else %}
        {% assign gb3_placeholder_title = section.settings.banner_title | default: 'Banner title' %}
        {% assign gb3_placeholder_desc = section.settings.banner_description | default: 'Lorem ipsum dolor sit amet' %}
        {% assign gb3_placeholder_btn = section.settings.banner_button_text | default: 'view more' %}
        <div class="gb3-banner-placeholder">
          <div class="gb3-banner-placeholder-inner">
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            <h3 class="gb3-title">{{ gb3_placeholder_title }}</h3>
            <div class="gb3-desc">{{ gb3_placeholder_desc }}</div>
            <span class="gb3-btn">{{ gb3_placeholder_btn }}</span>
          </div>
        </div>
      {% endif %}

      {% if has_banner_image and section.settings.show_overlay %}
        <span class="gb3-overlay"></span>
      {% endif %}

      {% if has_banner_image %}
        <div class="gb3-banner-caption">
          <div>
            {% if section.settings.banner_title != blank %}
              <h3 class="gb3-title">{{ section.settings.banner_title }}</h3>
            {% endif %}
            {% if section.settings.banner_description != blank %}
              <div class="gb3-desc">{{ section.settings.banner_description }}</div>
            {% endif %}
            {% if section.settings.banner_button_text != blank %}
              <span class="gb3-btn">{{ section.settings.banner_button_text }}</span>
            {% endif %}
          </div>
        </div>
      {% endif %}
    </a>

    {% if use_collection and section.settings.show_view_all and cards_collection_obj.products_count > cards_limit %}
      <div class="gb3-collection-actions">
        <a class="gb3-view-all" href="{{ cards_collection_obj.url }}">{{ 'collections.general.view_all' | t }}</a>
      </div>
    {% endif %}

    {% if use_collection %}
      <div class="gb3-products-grid" style="grid-template-columns: repeat({{ cards_limit }}, minmax(0, 1fr));">
        {% for product in cards_collection_obj.products limit: cards_limit %}
          <div class="gb3-product-card">
            <div class="gb3-product-media">
              {% assign gb3_badge_text = blank %}
              {% assign gb3_badge_class = blank %}
              {% if product.compare_at_price > product.price and product.available %}
                {% assign gb3_sale_minus = product.compare_at_price_min | minus: product.price_min %}
                {% assign gb3_sale_percent = gb3_sale_minus | times: 100 | divided_by: product.compare_at_price_min %}
                {% assign gb3_badge_text = gb3_sale_percent | append: '% Off' %}
                {% assign gb3_badge_class = 'gb3-product-badge--sale' %}
              {% else %}
                {% assign gb3_new_count = settings.new_label_day | default: 30 | plus: 0 %}
                {% assign gb3_date_published_year = product.published_at | date: '%Y' %}
                {% assign gb3_date_published_month = product.published_at | date: '%m' %}
                {% assign gb3_date_published_day = product.published_at | date: '%d' %}
                {% assign gb3_date_now_year = 'now' | date: '%Y' %}
                {% assign gb3_date_now_month = 'now' | date: '%m' %}
                {% assign gb3_date_now_day = 'now' | date: '%d' %}
                {% assign gb3_day_year = gb3_date_now_year | minus: gb3_date_published_year | times: 365 %}
                {% assign gb3_day_month = gb3_date_now_month | minus: gb3_date_published_month | times: 30 %}
                {% assign gb3_day_day = gb3_date_now_day | minus: gb3_date_published_day %}
                {% assign gb3_date_difference = gb3_day_year | plus: gb3_day_month | plus: gb3_day_day %}
                {% if gb3_date_difference <= gb3_new_count or product.tags contains 'new' %}
                  {% assign gb3_badge_text = 'New' %}
                  {% assign gb3_badge_class = 'gb3-product-badge--new' %}
                {% endif %}
              {% endif %}

