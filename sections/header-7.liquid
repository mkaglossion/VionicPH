<script>
  (function() {
    if (window.__header7DrawerResetBound) return;
    window.__header7DrawerResetBound = true;

    var DESKTOP_BREAKPOINT = 992;

    function closeDrawerNow() {
      if (window.theme && theme.NavDrawer && typeof theme.NavDrawer.close === 'function') {
        theme.NavDrawer.close();
      }

      document.documentElement.classList.remove('js-drawer-open', 'js-drawer-open-left');
      document.body.classList.remove('js-drawer-open', 'js-drawer-open-left');
    }

    function resetDrawerStateOnDesktop() {
      if (window.innerWidth < DESKTOP_BREAKPOINT) return;

      closeDrawerNow();

      document.querySelectorAll('.js-drawer-open[aria-expanded]').forEach(function(trigger) {
        trigger.setAttribute('aria-expanded', 'false');
      });

      var navDrawer = document.getElementById('NavDrawer');
      if (navDrawer) {
        navDrawer.style.transform = '';
      }

      document.querySelectorAll('.is-moved-by-drawer').forEach(function(el) {
        el.classList.remove('is-transitioning');
        el.style.transform = '';
        el.style.left = '';
      });
    }

    window.addEventListener('resize', resetDrawerStateOnDesktop, { passive: true });
    document.addEventListener('DOMContentLoaded', resetDrawerStateOnDesktop);
    resetDrawerStateOnDesktop();
  })();
</script>
