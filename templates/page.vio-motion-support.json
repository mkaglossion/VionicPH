 = document.getElementById(\u0027Email\u0027);\n            if (!emailInput.value.includes(\u0027@\u0027)) {\n                alert(\u0027Please enter a valid email address.\u0027);\n                event.preventDefault();\n            }\n        });\n\n        // JavaScript for Mobile Newsletter Signup Validation and Submission\n        document.getElementById(\u0027mobile-contact_form\u0027).addEventListener(\u0027submit\u0027, function(event) {\n            var emailInput = document.getElementById(\u0027mobile-Email\u0027);\n            if (!emailInput.value.includes(\u0027@\u0027)) {\n                alert(\u0027Please enter a valid email address.\u0027);\n                event.preventDefault();\n            }\n        });\n\n        // Check URL for \u0027customer_posted=true\u0027 and display thank-you message\n        function checkUrlAndDisplayMessage() {\n            const urlParams = new URLSearchParams(window.location.search);\n            if (urlParams.get(\u0027customer_posted\u0027) === \u0027true\u0027) {\n                document.getElementById(\u0027thank-you-message\u0027).style.display = \u0027block\u0027;\n                document.querySelector(\u0027.footer-section\u0027).scrollIntoView({\n                    behavior: \u0027smooth\u0027 // Smoothly scroll to the footer section\n                });\n            }\n        }\n\n        function checkMobileUrlAndDisplayMessage() {\n            const urlParams = new URLSearchParams(window.location.search);\n            if (urlParams.get(\u0027customer_posted\u0027) === \u0027true\u0027) {\n                document.getElementById(\u0027mobile-thank-you-message\u0027).style.display = \u0027block\u0027;\n                document.querySelector(\u0027.mobile-footer\u0027).scrollIntoView({\n                    behavior: \u0027smooth\u0027 // Smoothly scroll to the mobile footer section\n                });\n            }\n        }\n\n        checkUrlAndDisplayMessage();\n        checkMobileUrlAndDisplayMessage();\n    \u003c/script\u003e\n\n\u003c/body\u003e","width":"100%","align":"auto"}}},"block_order":["html_YkNARy"],"name":"Custom HTML","settings":{"animation":"","paddingsection":"0px 0px 0px 0px","paddingmobile":"0px 0px 0px 0px","marginsection":"0px 0px 0px 0px","marginmobile":"0px 0px 0px 0px","zindex":"0","title_top":"","title":"","des":"","setwidth":"full","padding":false,"col_center":false,"bgsection":"rgba(0,0,0,0)","rangebg":0,"bgbefore":"rgba(0,0,0,0)","e_size":"auto","e_repeat":"no-repeat"}}},"order":["main","grid_banner_E7bnzW","advanced_content_w7McVJ","backgroundvideo_GK7Aei","advanced_content_DMWajp","grid_banner_LpPWJL","advanced_content_YyNVTp","grid_banner_LpayUq","advanced_content_hdRpgx","advanced_content_aimH4Q"]}