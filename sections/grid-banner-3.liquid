                          data-tooltipalltimes="true"
                          data-placement="top"
                          title="{{ gb3_variant_label | default: product.title | escape }}"
                        >
                          <img
                            src="{{ gb3_thumb_image | image_url: width: 80 }}"
                            alt="{{ gb3_thumb_image.alt | default: product.title | escape }}"
                            width="24"
                            height="24"
                            loading="lazy"
                          >
                        </span>
                      </div>
                    {% endif %}
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
          {% if section.settings.show_mobile_pagination %}
            <div class="gb3-pagination swiper-pagination gb3-pagination-{{ section.id }}"></div>
          {% endif %}
        </div>
      {% endif %}
    {% endif %}
  </div>
</section>

{{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}
<script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer></script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    var slider = document.querySelector('.gb3-swiper-{{ section.id }}');
    if (slider) {
      var paginationEl = slider.querySelector('.gb3-pagination-{{ section.id }}');
      var mobileQuery = window.matchMedia('(max-width: 767px)');
      var swiperInstance = null;

      function buildSwiper() {
        if (swiperInstance) {
          swiperInstance.destroy(true, true);
          swiperInstance = null;
        }

        if (!mobileQuery.matches) {
          return;
        }

        swiperInstance = new Swiper(slider, {
          slidesPerView: 1,
          spaceBetween: {{ section.settings.gap_mobile }},
          loop: {% if rendered_cards_count > 1 and section.settings.carousel_loop %}true{% else %}false{% endif %},
          watchOverflow: false,
          pagination: {% if rendered_cards_count > 1 and section.settings.show_mobile_pagination %}paginationEl ? {
            el: paginationEl,
            clickable: true
          } : false{% else %}false{% endif %}
        });
      }

      buildSwiper();
      if (mobileQuery.addEventListener) {
        mobileQuery.addEventListener('change', buildSwiper);
      } else if (mobileQuery.addListener) {
        mobileQuery.addListener(buildSwiper);
      }
    }
  });
</script>

