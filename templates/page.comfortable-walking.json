pan class=\"dot active\" onclick=\"currentSlide(1, 'mobile')\"><\/span>\n      <span class=\"dot\" onclick=\"currentSlide(2, 'mobile')\"><\/span>\n      <span class=\"dot\" onclick=\"currentSlide(3, 'mobile')\"><\/span>\n    <\/div>\n  <\/div>\n\n  <!-- Desktop Carousel (shown on desktop only) -->\n  <div class=\"desktop-carousel\">\n    <div class=\"carousel-container\">\n      <!-- Slide 1 -->\n      <div class=\"carousel-slide active\">\n          <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0553\/5590\/0092\/files\/VioLab_Review_1_-_Dr._Sharkey.jpg?v=1754285775\" alt=\"Doctor 1 - Dr. Sharkey\">\n      <\/div>\n      <!-- Slide 2 -->\n      <div class=\"carousel-slide\">\n          <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0553\/5590\/0092\/files\/VioLab_Review_2_-_Karen.jpg?v=1754285775\" alt=\"Doctor 2 - Dr. Karen\">\n      <\/div>\n      <!-- Slide 3 -->\n      <div class=\"carousel-slide\">\n          <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0553\/5590\/0092\/files\/VioLab_Review_3_-_Saylee.jpg?v=1754285775\" alt=\"Doctor 3 - Dr. Saylee\">\n        <\/div>\n    <\/div>\n\n    <!-- Dots navigation -->\n    <div class=\"carousel-dots\">\n      <span class=\"dot active\" onclick=\"currentSlide(1, 'desktop')\"><\/span>\n      <span class=\"dot\" onclick=\"currentSlide(2, 'desktop')\"><\/span>\n      <span class=\"dot\" onclick=\"currentSlide(3, 'desktop')\"><\/span>\n    <\/div>\n  <\/div>\n\n  <script>\n    let mobileSlideIndex = 1;\n    let desktopSlideIndex = 1;\n    \n    function showSlides(n, type) {\n      const slides = document.querySelectorAll(`.${type}-carousel .carousel-slide`);\n      const dots = document.querySelectorAll(`.${type}-carousel .dot`);\n      \n      if (n > slides.length) {\n        if (type === 'mobile') mobileSlideIndex = 1;\n        else desktopSlideIndex = 1;\n      }\n      if (n < 1) {\n        if (type === 'mobile') mobileSlideIndex = slides.length;\n        else desktopSlideIndex = slides.length;\n      }\n      \n      for (let i = 0; i < slides.length; i++) {\n        slides[i].classList.remove(\"active\");\n        dots[i].classList.remove(\"active\");\n      }\n      \n      const currentIndex = type === 'mobile' ? mobileSlideIndex - 1 : desktopSlideIndex - 1;\n      slides[currentIndex].classList.add(\"active\");\n      dots[currentIndex].classList.add(\"active\");\n    }\n\n    function currentSlide(n, type) {\n      if (type === 'mobile') {\n        mobileSlideIndex = n;\n        showSlides(mobileSlideIndex, 'mobile');\n      } else {\n        desktopSlideIndex = n;\n        showSlides(desktopSlideIndex, 'desktop');\n      }\n    }\n\n    \/\/ Auto-rotate both carousels\n    setInterval(() => {\n      mobileSlideIndex++;\n      showSlides(mobileSlideIndex, 'mobile');\n    }, 5000);\n    \n    setInterval(() => {\n      desktopSlideIndex++;\n      showSlides(desktopSlideIndex, 'desktop');\n    }, 5000);\n\n    \/\/ Init both carousels\n    showSlides(mobileSlideIndex, 'mobile');\n    showSlides(desktopSlideIndex, 'desktop');\n  <\/script>\n<\/body>","width":"100%","align":"auto"}}},"block_order":["html_GhFCc6"],"name":"Custom HTML","settings":{"animation":"","paddingsection":"0px 0px 0px 0px","paddingmobile":"0px 0px 0px 0px","marginsection":"0px 0px 0px 0px","marginmobile":"0px 0px 0px 0px","zindex":"0","title_top":"","title":"","des":"","setwidth":"full","padding":true,"col_center":false,"bgsection":"#fefefe","rangebg":0,"bgbefore":"rgba(0,0,0,0)","e_size":"auto","e_repeat":"no-repeat"}},"grid_banner_UkncRY":{"type":"grid-banner","blocks":{"banner_c9dWaY":{"type":"banner","settings":{"image":"shopify:\/\/shop_images\/Walk_Max_Wanderer_Banner.jpg","width":"12","description":"","bg_color":"#fefefe","colordef":"#ffffff","opacity_bg":0,"style_btn":"btn-underline btn-underline-white","button_text":"","button_icon":"","button_link":"shopify:\/\/collections\/wanderer-shoes","vertical":"bottom","horizontal":"center","text_align":"center"}}},"block_order":["banner_