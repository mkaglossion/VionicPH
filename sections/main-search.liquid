{%- paginate search.results by 24 -%}
  {%- assign display_terms = search.terms | remove_first: 'title:' | remove: '*' | strip -%}
  {%- assign product_count = 0 -%}
  {%- assign content_count = 0 -%}

  {%- for item in search.results -%}
    {%- if item.object_type == 'product' -%}
      {%- assign product_count = product_count | plus: 1 -%}
    {%- else -%}
      {%- assign content_count = content_count | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}

  <section class="search-page" aria-labelledby="SearchPageTitle">
    <div class="container">
      <header class="search-page__hero">
        <div class="search-page__heading">
          <p class="search-page__eyebrow">Find your perfect pair</p>
          <h1 id="SearchPageTitle" class="search-page__title">
            {%- if search.performed and search.results_count > 0 -%}
              Results for <span>&ldquo;{{ display_terms | escape }}&rdquo;</span>
            {%- elsif search.performed -%}
              No results for <span>&ldquo;{{ display_terms | escape }}&rdquo;</span>
            {%- else -%}
              Search Vionic
            {%- endif -%}
          </h1>
          <p class="search-page__description">
            {%- if search.performed and search.results_count > 0 -%}
              {{ search.results_count }} {{ search.results_count | pluralize: 'result', 'results' }} found. Explore supportive styles designed for all-day comfort.
            {%- else -%}
              Search by product name, style, or category.
            {%- endif -%}
          </p>
        </div>

        <form class="search-page__form" action="{{ routes.search_url }}" method="get" role="search">
          <label class="visually-hidden" for="SearchPageInput">Search products</label>
          <div class="search-page__input-wrap">
            <span class="search-page__input-icon" aria-hidden="true">{%- render 'icon-search' -%}</span>
            <input
              id="SearchPageInput"
              class="search-page__input"
              type="search"
              name="q"
              value="{{ display_terms | escape }}"
              placeholder="Search shoes, sandals, insoles..."
              autocomplete="off"
            >
            <input type="hidden" name="type" value="product">
            <button class="search-page__submit" type="submit">Search</button>
          </div>
        </form>
      </header>

      {%- if search.performed and search.results_count > 0 -%}
        <div class="search-page__bar">
          <p>{{ search.results_count }} {{ search.results_count | pluralize: 'product', 'products' }}</p>
          <a href="{{ routes.search_url }}">Clear search</a>
        </div>

        {%- if product_count > 0 -%}
          <div class="search-page__grid" role="list">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                <div class="search-page__product" role="listitem">
                  {%- include 'product-card', product: item -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if content_count > 0 -%}
          <div class="search-page__content-results">
            <h2>{{ 'general.search.pages_and_articles' | t }}</h2>
            <div class="search-page__content-grid">
              {%- for item in search.results -%}
                {%- unless item.object_type == 'product' -%}
                  <article class="search-page__content-card">
                    <p class="search-page__content-type">{{ item.object_type }}</p>
                    <h3><a href="{{ item.url }}">{{ item.title }}</a></h3>
                    <p>{{ item.content | strip_html | truncatewords: 24 }}</p>
                    <a class="search-page__read-more" href="{{ item.url }}">{{ 'general.search.read_more' | t }}</a>
                  </article>
                {%- endunless -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        {%- if paginate.pages > 1 -%}
          <nav class="search-page__pagination" aria-label="Search results pagination">
            {{ paginate | default_pagination | replace: '&laquo; Previous', '&larr;' | replace: 'Next &raquo;', '&rarr;' }}
          </nav>
        {%- endif -%}
      {%- elsif search.performed -%}
        <div class="search-page__empty">
          <span aria-hidden="true">{%- render 'icon-search' -%}</span>
          <h2>We couldn&rsquo;t find a match</h2>
          <p>Check the spelling or try a broader product name or category.</p>
          <a class="search-page__shop-all" href="{{ routes.all_products_collection_url }}">Shop all products</a>
        </div>
      {%- endif -%}
    </div>
  </section>

  {%- assign dm_paginate_by = paginate.page_size -%}
{%- endpaginate -%}

{%- if dm_paginate_by -%}
  {%- render 'spurit_dmr_collection_template_snippet', paginate_by: dm_paginate_by -%}
{%- endif -%}
