<!-- grid-banner-3.liquid -->
{% assign gb3_placeholder_bg = section.settings.placeholder_bg %}
{% if gb3_placeholder_bg == blank or gb3_placeholder_bg == 'rgba(0,0,0,0)' or gb3_placeholder_bg == 'transparent' %}
  {% assign gb3_placeholder_bg = '#ffffff' %}
{% endif %}
<style>
  .gb3-{{ section.id }} {
    padding: {{ section.settings.paddingsection }};
    margin: {{ section.settings.marginsection }};
    background: #ffffff;
  }

  .gb3-{{ section.id }} .gb3-container.full {
    width: 100%;
    max-width: 100%;
    padding-left: 0;
    padding-right: 0;
  }

  .gb3-{{ section.id }} .gb3-heading {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 24px;
  }

  .gb3-{{ section.id }} .gb3-heading-title {
    margin: 0;
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 400;
    line-height: 1;
    letter-spacing: .04em;
    text-transform: uppercase;
    color: {{ section.settings.heading_color }};
    white-space: nowrap;
  }

  .gb3-{{ section.id }} .gb3-heading-line {
    flex: 1;
    height: 1px;
    background: {{ section.settings.heading_line_color }};
  }

  .gb3-{{ section.id }} .gb3-banner {
    position: relative;
    display: block;
    width: 100%;
    height: {{ section.settings.banner_height }}px;
    overflow: hidden;
    text-decoration: none;
    background: {{ gb3_placeholder_bg }};
    border-radius: 0;
  }

  .gb3-{{ section.id }} .gb3-banner.gb3-banner--adapt {
    height: auto;
    background: transparent;
  }

  .gb3-{{ section.id }} .gb3-banner-media,
  .gb3-{{ section.id }} .gb3-banner-media img {
    width: 100%;
    height: 100%;
  }

  .gb3-{{ section.id }} .gb3-banner-media .desktop-img,
  .gb3-{{ section.id }} .gb3-banner-media .mobile-img {
    object-fit: cover;
    display: block;
  }

  .gb3-{{ section.id }} .gb3-banner.gb3-banner--adapt .gb3-banner-media,
  .gb3-{{ section.id }} .gb3-banner.gb3-banner--adapt .gb3-banner-media img {
    height: auto;
  }

  .gb3-{{ section.id }} .gb3-banner.gb3-banner--adapt .gb3-banner-media .desktop-img,
  .gb3-{{ section.id }} .gb3-banner.gb3-banner--adapt .gb3-banner-media .mobile-img {
    object-fit: contain;
  }

  .gb3-{{ section.id }} .gb3-banner-media .mobile-img {
    display: none;
  }

  .gb3-{{ section.id }} .gb3-banner-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 20px;
    color: {{ section.settings.text_color }};
  }

  .gb3-{{ section.id }} .gb3-banner-placeholder svg {
    width: clamp(120px, 16vw, 220px);
    height: clamp(120px, 16vw, 220px);
    opacity: .8;
    margin-bottom: 22px;
  }

  .gb3-{{ section.id }} .gb3-overlay {
    position: absolute;
    inset: 0;
    background: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity }};
    z-index: 1;
  }

  .gb3-{{ section.id }} .gb3-banner-caption {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: {{ section.settings.text_color }};
    padding: 20px;
  }

  .gb3-{{ section.id }} .gb3-title {
    margin: 0 0 12px;
    font-size: {{ section.settings.title_size }}px;
    font-weight: 600;
    line-height: 1.2;
    color: {{ section.settings.text_color }};
    text-transform: uppercase;
    letter-spacing: .02em;
  }

  .gb3-{{ section.id }} .gb3-desc {
    margin: 0 0 22px;
    font-size: {{ section.settings.desc_size }}px;
    font-weight: 600;
    color: {{ section.settings.text_color }};
  }

  .gb3-{{ section.id }} .gb3-btn {
    display: inline-block;
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.button_size }}px;
    font-weight: 600;
    line-height: 1;
    border-bottom: 2px solid {{ section.settings.text_color }};
    padding-bottom: 6px;
  }

  .gb3-{{ section.id }} .gb3-products-grid {
    display: none;
  }

  .gb3-{{ section.id }} .gb3-products-slider {
    display: block;
    margin-top: {{ section.settings.gap }}px;
  }

  .gb3-{{ section.id }} .gb3-products-slider .swiper-slide {
    height: auto;
  }

  .gb3-{{ section.id }} .gb3-product-card {
    display: block;
    text-decoration: none;
    color: #1f1f1f;
  }

  .gb3-{{ section.id }} .gb3-product-media {
    width: 100%;
    aspect-ratio: 1 / 1;
    height: auto;
    border-radius: {{ section.settings.item_border_radius }}px;
    overflow: hidden;
    background: transparent;
  }

  .gb3-{{ section.id }} .gb3-product-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .gb3-{{ section.id }} .gb3-product-meta {
    text-align: center;
    margin-top: 10px;
    padding: 0 6px;
  }

  .gb3-{{ section.id }} .gb3-product-title {
    margin: 0;
    font-size: 12px;
    font-weight: 600;
    line-height: 1.35;
    color: #222;
    text-transform: uppercase;
    letter-spacing: .02em;
  }

  .gb3-{{ section.id }} .gb3-product-price {
    margin-top: 4px;
    font-size: 12px;
    color: #222;
    font-weight: 500;
  }

  .gb3-{{ section.id }} .gb3-products-slider.swiper {
    position: relative;
    width: 100%;
    overflow: hidden;
    padding-bottom: 26px;
  }

  .gb3-{{ section.id }} .gb3-products-slider .swiper-pagination {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
  }

  .gb3-{{ section.id }} .swiper-button-prev,
  .gb3-{{ section.id }} .swiper-button-next {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(0,0,0,0.5);
  }

  .gb3-{{ section.id }} .swiper-button-prev:after,
  .gb3-{{ section.id }} .swiper-button-next:after {
    font-size: 16px;
    color: #fff;
  }

  .gb3-{{ section.id }} .swiper-pagination-bullet {
    width: 9px;
    height: 9px;
    background: #ccc;
    opacity: 0.8;
  }

  .gb3-{{ section.id }} .swiper-pagination-bullet-active {
    background: #000;
    opacity: 1;
  }

  @media (max-width: 767px) {
    .gb3-{{ section.id }} {
      padding: {{ section.settings.paddingmobile }} !important;
      margin: {{ section.settings.marginmobile }} !important;
    }

    .gb3-{{ section.id }} .gb3-heading {
      margin-bottom: 18px;
      justify-content: center;
      text-align: center;
    }

    .gb3-{{ section.id }} .gb3-heading-line {
      display: none;
    }

    .gb3-{{ section.id }} .gb3-heading-title {
      font-size: 18px;
      white-space: normal;
    }

    .gb3-{{ section.id }} .gb3-banner {
      height: {{ section.settings.banner_height_mobile }}px;
    }

    .gb3-{{ section.id }} .gb3-banner.gb3-banner--adapt {
      height: auto !important;
    }

    .gb3-{{ section.id }} .gb3-banner-media .desktop-img {
      display: none;
    }

    .gb3-{{ section.id }} .gb3-banner-media .mobile-img {
      display: block;
    }

    .gb3-{{ section.id }} .gb3-products-slider {
      margin-top: {{ section.settings.gap_mobile }}px;
    }

    .gb3-{{ section.id }} .gb3-products-slider .gb3-product-media {
      aspect-ratio: 1 / 1;
      height: auto;
    }

  }
</style>

<section class="gb3-{{ section.id }}" data-aos="{{ section.settings.animation }}">
  <div class="gb3-container {{ section.settings.setwidth }}">
    {% if section.settings.heading != blank %}
      <div class="gb3-heading">
        <h2 class="gb3-heading-title">{{ section.settings.heading }}</h2>
        <span class="gb3-heading-line"></span>
      </div>
    {% endif %}

    {% assign has_banner_image = false %}
    {% if section.settings.banner_image != blank or section.settings.banner_image_mobile != blank %}
      {% assign has_banner_image = true %}
    {% endif %}
    {% assign desktop_banner_image = section.settings.banner_image | default: section.settings.banner_image_mobile %}
    {% assign mobile_banner_image = section.settings.banner_image_mobile | default: section.settings.banner_image %}
    <a
      href="{{ section.settings.banner_link | default: '#' }}"
      class="gb3-banner{% if has_banner_image and section.settings.banner_height_mode == 'adapt' %} gb3-banner--adapt{% endif %}"
    >
      {% if has_banner_image %}
        <div class="gb3-banner-media">
          {% if desktop_banner_image != blank %}
            <img
              class="desktop-img"
              src="{{ desktop_banner_image | image_url: width: 1920 }}"
              alt="{{ desktop_banner_image.alt | default: section.settings.banner_title | escape }}"
              width="{{ desktop_banner_image.width }}"
              height="{{ desktop_banner_image.height }}"
              loading="lazy"
            >
          {% endif %}
          {% if mobile_banner_image != blank %}
            <img
              class="mobile-img"
              src="{{ mobile_banner_image | image_url: width: 1200 }}"
              alt="{{ mobile_banner_image.alt | default: section.settings.banner_title | escape }}"
              width="{{ mobile_banner_image.width }}"
              height="{{ mobile_banner_image.height }}"
              loading="lazy"
            >
          {% endif %}
        </div>
      {% else %}
        <div class="gb3-banner-placeholder">
          <div>
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        </div>
      {% endif %}

      {% if section.settings.show_overlay %}
        <span class="gb3-overlay"></span>
      {% endif %}

      <div class="gb3-banner-caption">
        <div>
          {% if section.settings.banner_title != blank %}
            <h3 class="gb3-title">{{ section.settings.banner_title }}</h3>
          {% endif %}
          {% if section.settings.banner_description != blank %}
            <div class="gb3-desc">{{ section.settings.banner_description }}</div>
          {% endif %}
          {% if section.settings.banner_button_text != blank %}
            <span class="gb3-btn">{{ section.settings.banner_button_text }}</span>
          {% endif %}
        </div>
      </div>
    </a>

    {% assign cards_collection_obj = blank %}
    {% assign cards_per_view_desktop = section.settings.collection_cards_limit | default: 4 | at_least: 1 | at_most: 6 %}
    {% assign cards_limit = 0 %}
    {% assign rendered_cards_count = 0 %}
    {% assign use_collection = false %}
    {% if section.settings.cards_collection != blank %}
      {% assign cards_collection_obj = collections[section.settings.cards_collection] %}
      {% if cards_collection_obj != blank and cards_collection_obj.products_count > 0 %}
        {% assign use_collection = true %}
        {% assign cards_limit = cards_collection_obj.products_count %}
        {% assign rendered_cards_count = cards_collection_obj.products_count %}
      {% endif %}
    {% endif %}

    {% if use_collection %}
      <div class="gb3-products-slider swiper gb3-swiper-{{ section.id }}">
        <div class="swiper-wrapper">
          {% for product in cards_collection_obj.products limit: cards_limit %}
            <div class="swiper-slide">
              <a href="{{ product.url | within: cards_collection_obj }}" class="gb3-product-card">
                <div class="gb3-product-media">
                  {% if product.featured_image != blank %}
                    <img
                      src="{{ product.featured_image | image_url: width: 800 }}"
                      alt="{{ product.featured_image.alt | default: product.title | escape }}"
                      width="800"
                      height="800"
                      loading="lazy"
                    >
                  {% else %}
                    {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {% endif %}
                </div>
                <div class="gb3-product-meta">
                  <p class="gb3-product-title">{{ product.title }}</p>
                  <div class="gb3-product-price">{{ product.price | money }}</div>
                </div>
              </a>
            </div>
          {% endfor %}
        </div>
        <div class="swiper-pagination gb3-slider-pagination-{{ section.id }}"></div>
      </div>
    {% endif %}
  </div>
</section>

{{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}
<script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer></script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    var slider = document.querySelector('.gb3-swiper-{{ section.id }}');
    if (slider) {
      var paginationEl = slider.querySelector('.gb3-slider-pagination-{{ section.id }}');
      var nextEl = slider.querySelector('.gb3-slider-next-{{ section.id }}');
      var prevEl = slider.querySelector('.gb3-slider-prev-{{ section.id }}');
      new Swiper(slider, {
        slidesPerView: 1,
        spaceBetween: {{ section.settings.gap_mobile }},
        loop: {% if rendered_cards_count > 1 %}{{ section.settings.carousel_loop | default: false }}{% else %}false{% endif %},
        watchOverflow: false,
        navigation: nextEl && prevEl
          ? {
              nextEl: nextEl,
              prevEl: prevEl
            }
          : false,
        pagination: paginationEl
          ? {
              el: paginationEl,
              clickable: true
            }
          : false,
        breakpoints: {
          768: {
            slidesPerView: 2,
            spaceBetween: {{ section.settings.gap }}
          },
          992: {
            slidesPerView: 3,
            spaceBetween: {{ section.settings.gap }}
          },
          1200: {
            slidesPerView: {{ cards_per_view_desktop }},
            spaceBetween: {{ section.settings.gap }}
          }
        }
      });
    }
  });
</script>

