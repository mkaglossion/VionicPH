ssage\" style=\"display:none;\">\n                Thank you for signing up for emails!\n            <\/div>\n        <\/div>\n        <h2 class=\"follow-us\" style=\"margin-top: 20px;\">FOLLOW US<\/h2>\n        <div class=\"social-icons\">\n            <a href=\"https:\/\/www.facebook.com\/vionicshoesph\"><img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0553\/5590\/0092\/files\/icon_facebook_1.webp\" alt=\"Facebook\"><\/a>\n            <a href=\"https:\/\/www.instagram.com\/vionicshoesph\/\"><img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0553\/5590\/0092\/files\/icon_instagram_1.webp\" alt=\"Instagram\"><\/a>\n        <\/div>\n    <\/div>\n\n    <script>\n        \/\/ JavaScript for Newsletter Signup Validation and Submission\n        document.getElementById('contact_form').addEventListener('submit', function(event) {\n            var emailInput = document.getElementById('Email');\n            if (!emailInput.value.includes('@')) {\n                alert('Please enter a valid email address.');\n                event.preventDefault();\n            }\n        });\n\n        \/\/ JavaScript for Mobile Newsletter Signup Validation and Submission\n        document.getElementById('mobile-contact_form').addEventListener('submit', function(event) {\n            var emailInput = document.getElementById('mobile-Email');\n            if (!emailInput.value.includes('@')) {\n                alert('Please enter a valid email address.');\n                event.preventDefault();\n            }\n        });\n\n        \/\/ Check URL for 'customer_posted=true' and display thank-you message\n        function checkUrlAndDisplayMessage() {\n            const urlParams = new URLSearchParams(window.location.search);\n            if (urlParams.get('customer_posted') === 'true') {\n                document.getElementById('thank-you-message').style.display = 'block';\n                document.querySelector('.footer-section').scrollIntoView({\n                    behavior: 'smooth' \/\/