_link":"","vertical":"mid","horizontal":"center","text_align":"center"}},"banner_yVhdJb":{"type":"banner","disabled":true,"settings":{"image":"shopify://shop_images/pf-step3.jpg","width":"4","description":"","bg_color":"#fefefe","colordef":"#ffffff","opacity_bg":0,"style_btn":"btn-underline btn-underline-white","button_text":"","button_icon":"","button_link":"","vertical":"mid","horizontal":"center","text_align":"center"}}},"block_order":["banner_QfMaXa","banner_3ARydb","banner_yVhdJb"],"disabled":true,"settings":{"animation":"","paddingsection":"0px 0px 0px 0px","paddingmobile":"60px 0px 60px 0px","marginsection":"0px 0px 0px 0px","marginmobile":"0px 0px 0px 0px","bgsection":"#fefefe","bgstyle":false,"bgbefore":"#e3c9b8","title_top":"","title":"HOW TO FIND RELIEF","des":"Five Healthy Tips for Preventing or Reducing Plantar Fasciitis","setwidth":"container-fluid","no_gutter":false,"show_overlay":true,"gradient_overlay":true,"bg_overlay":"#000000","opacity_overlay":0.4}},"grid_banner_2_cHQWdA":{"type":"grid-banner-2","blocks":{"banner_EHRUCg":{"type":"banner","settings":{"paddingblock":"0px 0px 0px 0px","bg_image":"","border_banner":"#dddddd","bg_banner":"#f1f1f1","opbg_banner":0.4,"image":"shopify://shop_images/pf-step1.jpg","width":"4","description":"<h3 class=\"mb-2\">1</h3>\n<h3 class=\"mb-2\">BREAK THE CYCLE WITH SUPPORTIVE FOOTWEAR</h3>\n<p> </p>\n<p>Wearing supportive orthopedic shoes or insoles (orthotics) is an easy, effective method of naturally realigning the foot. A groundbreaking study shows Vionic sandals <a href=\"https://www.example.com\" target=\"_blank\">effectively alleviate heel pain</a>. Worn consistently throughout the day, orthotic shoes with arch support are a great first step in the short‑term treatment of plantar fasciitis.</p>","button_text":"","button_link":"","reverse":"flex-column","text_align":"center"}},"banner_VQKUXn":{"type":"banner","settings":{"paddingblock":"0px 0px 0px 0px","bg_image":"","border_banner":"#dddddd","bg_banner":"#f1f1f1","opbg_banner":0.4,"image":"shopify://shop_images/pf-step2.jpg","width":"4","description":"<h3 class=\"mb-2\">2</h3>\n<h3 class=\"mb-2\">STRETCH REGULARLY</h3>\n<p> </p>\n<p>Keeping your calf muscles limber helps to reduce the strain on the plantar fascia. To stretch your calves and Achilles tendon, stand on the edge of a step, resting your weight on the balls of your feet. Bend your knees for 25 seconds and then straighten. Perform up to five repetitions whenever tightening occurs.\n<a href=\"https://www.example.com\" target=\"_blank\">Learn effective stretches here.</a></p>","button_text":"","button_link":"","reverse":"flex-column","text_align":"center"}},"banner_7Dxjke":{"type":"banner","settings":{"paddingblock":"0px 0px 0px 0px","bg_image":"","border_banner":"#dddddd","bg_banner":"#f1f1f1","opbg_banner":0.4,"image":"shopify://shop_images/pf-step3.jpg","width":"4","description":"<h3 class=\"mb-2\">3</h3>\n<h3 class=\"mb-2\">PRESERVE YOUR ARCH WITH EXERCISES</h3>\n<p> </p>\n<p>While seated and barefoot, squeeze your foot as if you have a small marble under the ball of your foot. If you just happen to have a few marbles handy, you can actually practice picking them up between your toes and ball of your foot – and then set them down again. This stretches and helps strengthen the muscles that run under metatarsals (the longest bones in the foot which create its arched shape).</p>","button_text":"","button_link":"","reverse":"flex-column","text_align":"center"}}},"block_order":["banner_EHRUCg","banner_VQKUXn","banner_7Dxjke"],"disabled":true,"settings":{"animation":"","paddingsection":"0px 0px 0px 0px","paddingmobile":"60px 0px 60px 0px","marginsection":"0px 0px 0px 0px","marginmobile":"0px 0px 0px 0px","bgsection":"#fefefe","title_top":"","title":"HOW TO FIND RELIEF","des":"Five Healthy Tips for Preventing or Reducing Plantar Fasciitis","setwidth":"container-fluid","no_gutter":false}},"grid_banner_2_nbnN8z":{"type":"grid-banner-2","blocks":{"banner_WWgzBY":{"ty