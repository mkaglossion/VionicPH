{%- if settings.e_swatch -%}
  {%- assign color_value_count = 0 -%}
  {%- assign product_base_url = product.url | split: '?' | first -%}
  {%- assign color_values = blank -%}
  {%- assign size_option_index = blank -%}
  {%- assign size_values = blank -%}
  {%- assign sibling_metafield = product.metafields.custom.sibling_products -%}
  {%- assign sibling_values = sibling_metafield.value -%}
  {%- assign sibling_product_count = 0 -%}

  {%- for option in product.options_with_values -%}
    {%- assign option_name = option.name | handleize -%}
    {%- if option_name contains 'colo' -%}
      {%- assign color_value_count = option.values.size -%}
      {%- assign color_values = option.values -%}
    {%- elsif option_name contains 'size' -%}
      {%- assign size_option_index = forloop.index0 -%}
      {%- assign size_values = option.values -%}
    {%- endif -%}
  {%- endfor -%}

  {%- for sibling_entry in sibling_values limit: 6 -%}
    {%- assign sibling_product = blank -%}
    {%- if sibling_metafield.type == 'list.product_reference' -%}
      {%- assign sibling_product = sibling_entry -%}
    {%- else -%}
      {%- assign sibling_handle = sibling_entry | handleize -%}
      {%- assign sibling_product = all_products[sibling_handle] -%}
    {%- endif -%}

    {%- if sibling_product != blank and sibling_product.id != product.id -%}
      {%- assign sibling_product_count = sibling_product_count | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}

  {%- if sibling_product_count > 0 -%}
    <ul class="product-card__swatch product-card__sibling-swatches list-unstyled" aria-label="Other colors or styles">
      <li class="product-card__sibling-swatch is-active">
        <span aria-label="Current product: {{ product.title | escape }}" aria-current="true">
          {%- if product.featured_image != blank -%}
            <img
              src="{{ product.featured_image | img_url: '80x' }}"
              alt=""
              width="40"
              height="40"
              loading="lazy"
            >
          {%- endif -%}
        </span>
      </li>

      {%- for sibling_entry in sibling_values limit: 6 -%}
        {%- assign sibling_product = blank -%}
        {%- if sibling_metafield.type == 'list.product_reference' -%}
          {%- assign sibling_product = sibling_entry -%}
        {%- else -%}
          {%- assign sibling_handle = sibling_entry | handleize -%}
          {%- assign sibling_product = all_products[sibling_handle] -%}
        {%- endif -%}

        {%- if sibling_product != blank and sibling_product.id != product.id -%}
          <li class="product-card__sibling-swatch{% unless sibling_product.available %} is-unavailable{% endunless %}">
            <a href="{{ sibling_product.url }}" aria-label="View {{ sibling_product.title | escape }}">
              {%- if sibling_product.featured_image != blank -%}
                <img
                  src="{{ sibling_product.featured_image | img_url: '80x' }}"
                  alt=""
                  width="40"
                  height="40"
                  loading="lazy"
                >
              {%- endif -%}
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  {%- elsif color_value_count == 1 and color_values != blank -%}
    {%- assign color_value = color_values | first -%}
    {%- assign color_variant = product.selected_or_first_available_variant -%}
    <ul class="product-card__swatch product-card__color-swatches list-unstyled" aria-label="Color">
      <li class="product-card__color-swatch">
        <a href="{{ product_base_url }}" aria-label="{{ product.title | escape }} color {{ color_value | escape }}" title="{{ color_value | escape }}">
          {%- assign color_image = color_variant.image | default: product.featured_image -%}
          {%- if color_image != blank -%}
            <img src="{{ color_image | img_url: '80x80' }}" alt="{{ color_value | escape }}" width="40" height="40" loading="lazy">
          {%- endif -%}
        </a>
      </li>
    </ul>
  {%- elsif color_value_count > 1 -%}
    <ul class="product-card__swatch list-unstyled{% if settings.swatch_color %} sw_color{% endif %}{% if settings.swatch_color_circle %} round-color{% endif %}" aria-label="Available colors">
      {%- assign counter = 0 -%}
      {%- assign arrayVariants = '' -%}
      {%- for option in product.options -%}
        {%- if option == 'Color' or option == 'Colour' -%}
          {%- assign index = forloop.index0 -%}
          {%- for variant in product.variants -%}
            {%- assign swatch_file_extension = 'png' -%}
            {%- capture color -%}{{ variant.options[index] }}{%- endcapture -%}
            {%- if counter < 4 -%}
              {%- unless arrayVariants contains variant.image -%}
                {%- assign arrayVariants = arrayVariants | append: variant.image -%}
                {%- if variant.image != blank -%}
                  <li
                    data-tooltip="true"
                    data-tooltipalltimes="true"
                    class="js-swatch-card-item"
                    title="{{ variant.title }}"
                    data-url="{{ variant.url | within: collection }}"
                    data-id="{{ variant.id }}"
                    data-image="{{ variant.image | img_url: 'large' }}"
                    data-price="{{ variant.price }}"
                  >
                    {%- if settings.swatch_color -%}
                      <span style="background-color:{{ color | handle }};background-image:url({{ color | handle | append: '.' | append: swatch_file_extension | file_img_url: '50x' | prepend: 'https:' | split: '?' | first }})"></span>
                    {%- else -%}
                      <img data-sizes="auto" src="{%- include 'srcBlank' -%}" class="lazyload" data-src="{{ variant.image | img_url: 'small' }}" alt="{{ variant.image.alt }}">
                    {%- endif -%}
                  </li>
                  {%- assign counter = counter | plus: 1 -%}
                {%- endif -%}
              {%- endunless -%}
            {%- else -%}
              <li><a class="small" href="{{ product.url | within: collection }}" title="{{ 'products.product.view_more' | t }}">All ({{ product.variants.size }})</a></li>
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      {%- endfor -%}
    </ul>
  {%- endif -%}

  {%- if size_option_index != blank and size_values != blank -%}
    {%- if sibling_product_count > 0 or color_value_count <= 1 -%}
    <ul class="product-card__swatch product-card__size-swatches list-unstyled" aria-label="Available sizes">
      {%- for value in size_values -%}
        {%- assign available_size_variant = blank -%}
        {%- for variant in product.variants -%}
          {%- if variant.options[size_option_index] == value and variant.available -%}
            {%- assign available_size_variant = variant -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}

        {%- if forloop.index <= 6 -%}
          <li class="product-card__size-swatch{% if available_size_variant == blank %} is-unavailable{% endif %}">
            {%- if available_size_variant != blank -%}
              <a href="{{ product_base_url }}?variant={{ available_size_variant.id }}" aria-label="View {{ product.title | escape }} in size {{ value | escape }}">{{ value }}</a>
            {%- else -%}
              <span aria-label="{{ product.title | escape }} size {{ value | escape }} sold out" aria-disabled="true">{{ value }}</span>
            {%- endif -%}
          </li>
        {%- elsif forloop.index == 7 -%}
          <li class="product-card__size-swatch product-card__size-swatch--more">
            <a href="{{ product_base_url }}" aria-label="View all sizes for {{ product.title | escape }}">+{{ size_values.size | minus: 6 }}</a>
          </li>
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
    </ul>
    {%- endif -%}
  {%- endif -%}
{%- endif -%}
