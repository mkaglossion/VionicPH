{%- assign wishlist_page = pages[settings.page_wishlist] -%}
{%- if settings.enable_wishlsit and wishlist_page != blank -%}
<a href="{{ wishlist_page.url }}" class="site-header__link site-header__wishlist js-wishlist-link" title="{{ 'products.product.wishlist_text' | t }}" aria-label="{{ 'products.product.wishlist_text' | t }}">
  {%- render 'icon-heart' -%}
  <span class="js-wishlist-count" aria-hidden="true"></span>
</a>
{%- endif -%}
