367 or +639177018367 and +639171023218<\/p>\n        <p class=\"operating-hours\">Monday to Sunday <\/p>\n        <a href=\"mailto:customerservice@vionicshoes.com.ph\" class=\"spacing-links\">DROP US A NOTE<\/a>\n        <a href=\"\/pages\/store-locations\" class=\"spacing-links\">FIND A STORE<\/a>\n        <div class=\"email-signup-form\">\n            <p>Sign up for our email list.<\/p>\n            <p>You'll be the first to know about the latest styles and promotions.<\/p>\n            <form action=\"\/contact#contact_form\" method=\"post\" id=\"mobile-contact_form\" accept-charset=\"UTF-8\" class=\"contact-form\">\n                <input type=\"hidden\" name=\"form_type\" value=\"customer\">\n                <input type=\"hidden\" name=\"utf8\" value=\"✓\">\n                <input type=\"email\" name=\"contact[email]\" id=\"mobile-Email\" placeholder=\"Enter email\" aria-label=\"Enter email\" required>\n                <button type=\"submit\" name=\"commit\">SUBMIT<\/button>\n            <\/form>\n            <div id=\"mobile-thank-you-message\" style=\"display:none;\">\n                Thank you for signing up for emails!\n            <\/div>\n        <\/div>\n        <h2 class=\"follow-us\" style=\"margin-top: 20px;\">FOLLOW US<\/h2>\n        <div class=\"social-icons\">\n            <a href=\"https:\/\/www.facebook.com\/vionicshoesph\"><img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0553\/5590\/0092\/files\/icon_facebook_1.webp\" alt=\"Facebook\"><\/a>\n            <a href=\"https:\/\/www.instagram.com\/vionicshoesph\/\"><img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0553\/5590\/0092\/files\/icon_instagram_1.webp\" alt=\"Instagram\"><\/a>\n        <\/div>\n    <\/div>\n\n    <script>\n        \/\/ JavaScript for Newsletter Signup Validation and Submission\n        document.getElementById('contact_form').addEventListener('submit', function(event) {\n            var emailInput = document.getElementById('Email');\n            if (!emailInput.value.includes('@')) {\n                alert('Please enter a valid email address.');\n                event.preventDefault();\n            }\n        });\n\n        \/\/ JavaScript for Mobile Newsletter Signup Validation and Submission\n        document.getElementById('mobile-contact_form').addEventListener('submit', function(event) {\n            var emailInput = document.getElementById('mobile-Email');\n            if (!emailInput.value.includes('@')) {\n                alert('Please enter a valid email address.');\n                event.preventDefault();\n            }\n        });\n\n        \/\/ Check URL for 'customer_posted=true' and display thank-you message\n        function checkUrlAndDisplayMessage() {\n            const urlParams = new URLSearchParams(window.location.search);\n            if (urlParams.get('customer_posted') === 'true') {\n                document.getElementById('thank-you-message').style.display = 'block';\n                document.querySelector('.footer-section').scrollIntoView({\n                    behavior: 'smooth' \/\/ Smoothly scroll to the footer section\n                });\n            }\n        }\n\n        function checkMobileUrlAndDisplayMessage() {\n            const urlParams = new URLSearchParams(window.location.search);\n            if (urlParams.get('customer_posted') === 'true') {\n                document.getElementById('mobile-thank-you-message').style.display = 'block';\n                document.querySelector('.mobile-footer').scrollIntoView({\n                    behavior: 'smooth' \/\/ Smoothly scroll to the mobile footer section\n                });\n            }\n        }\n\n        checkUrlAndDisplayMessage();\n        checkMobileUrlAndDisplayMessage();\n    <\/script>\n\n<\/body>","width":"100%","align":"auto"}}},"block_order":["html_YkNARy"],"name":"Custom HTML","settings":{"animation":"","paddingsection":"0px 0px 0px 0px","paddingmobile":"0px 0px 0px 0px","marginsection":"0px 0px 0px 0px","marginmobile":"0px 0px 0px