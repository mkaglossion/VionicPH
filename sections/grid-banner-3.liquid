                  {%- include 'icon-heart' -%}
                </button>
              {% endif %}
            </div>
            <div class="gb3-product-meta">
              {% assign gb3_variant_label = product.selected_or_first_available_variant.option1 | strip %}
              {% if product.has_only_default_variant or gb3_variant_label == blank or gb3_variant_label == 'Default Title' %}
                {% assign gb3_variant_label = blank %}
              {% endif %}
              {% assign gb3_display_title = product.title %}
              {% if gb3_variant_label != blank %}
                {% assign gb3_title_suffix = ' ' | append: gb3_variant_label %}
                {% assign gb3_title_suffix_slash = ' / ' | append: gb3_variant_label %}
                {% assign gb3_display_title = gb3_display_title | replace: gb3_title_suffix_slash, '' %}
                {% assign gb3_display_title = gb3_display_title | replace: gb3_title_suffix, '' %}
              {% endif %}
              {% assign gb3_display_title = gb3_display_title | replace: '-', '' | strip %}
              <p class="gb3-product-title"><a href="{{ product.url | within: cards_collection_obj }}">{{ gb3_display_title }}</a></p>
              {% if gb3_variant_label != blank %}
                <div class="gb3-product-variant">{{ gb3_variant_label }}</div>
              {% endif %}
              <div class="gb3-product-price">{{ product.price | money }}</div>
              {% assign gb3_thumb_image = product.selected_or_first_available_variant.image | default: product.featured_image %}
              {% if gb3_thumb_image != blank %}
                <div class="gb3-product-thumb-wrap">
                  <span
                    class="gb3-product-thumb"
                    data-tooltip="true"
                    data-tooltipalltimes="true"
                    data-placement="top"
                    title="{{ gb3_variant_label | default: product.title | escape }}"
                  >
                    <img
                      src="{{ gb3_thumb_image | image_url: width: 80 }}"
                      alt="{{ gb3_thumb_image.alt | default: product.title | escape }}"
                      width="24"
                      height="24"
                      loading="lazy"
                    >
                  </span>
                </div>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>

      {% if gb3_mobile_carousel_enabled %}
        <div class="gb3-products-slider swiper gb3-swiper-{{ section.id }}">
          <div class="swiper-wrapper">
            {% for product in cards_collection_obj.products limit: cards_limit %}
              <div class="swiper-slide">
                <div class="gb3-product-card">
                  <div class="gb3-product-media">
                    {% assign gb3_badge_text = blank %}
                    {% assign gb3_badge_class = blank %}
                    {% if product.compare_at_price > product.price and product.available %}
                      {% assign gb3_sale_minus = product.compare_at_price_min | minus: product.price_min %}
                      {% assign gb3_sale_percent = gb3_sale_minus | times: 100 | divided_by: product.compare_at_price_min %}
                      {% assign gb3_badge_text = gb3_sale_percent | append: '% Off' %}
                      {% assign gb3_badge_class = 'gb3-product-badge--sale' %}
                    {% else %}
                      {% assign gb3_new_count = settings.new_label_day | default: 30 | plus: 0 %}
                      {% assign gb3_date_published_year = product.published_at | date: '%Y' %}
                      {% assign gb3_date_published_month = product.published_at | date: '%m' %}
                      {% assign gb3_date_published_day = product.published_at | date: '%d' %}
                      {% assign gb3_date_now_year = 'now' | date: '%Y' %}
                      {% assign gb3_date_now_month = 'now' | date: '%m' %}
                      {% assign gb3_date_now_day = 'now' | date: '%d' %}
                      {% assign gb3_day_year = gb3_date_now_year | minus: gb3_date_published_year | times: 365 %}
                      {% assign gb3_day_month = gb3_date_now_month | minus: gb3_date_published_month | times: 30 %}
                      {% assign gb3_day_day = gb3_date_now_day | minus: gb3_date_published_day %}
                      {% assign gb3_date_difference = gb3_day_year | plus: gb3_day_month | plus: gb3_day_day %}
                      {% if gb3_date_difference <= gb3_new_count or product.tags contains 'new' %}
                        {% assign gb3_badge_text = 'New' %}
                        {% assign gb3_badge_class = 'gb3-product-badge--new' %}
                      {% endif %}
                    {% endif %}

                    <a href="{{ product.url | within: cards_collection_obj }}" class="gb3-product-image-link" aria-label="{{ product.title | escape }}">
                      {% if product.featured_image != blank %}
                        <img
                          src="{{ product.featured_image | image_url: width: 800 }}"
                          alt="{{ product.featured_image.alt | default: product.title | escape }}"
                          width="800"
                          height="800"
                          loading="lazy"
                        >
                      {% else %}
                        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                      {% endif %}
                    </a>
                    {% if gb3_badge_text != blank %}
                      <span class="gb3-product-badge {{ gb3_badge_class }}">{{ gb3_badge_text }}</span>
                    {% endif %}
                    {% if settings.enable_wishlsit %}
                      <button type="button" data-toggle="tooltip" data-placement="left" data-tooltipalltimes="true" class="gb3-product-wishlist js-btn-wishlist" title="{{ 'products.product.wishlist_text' | t }}" data-handle="{{ product.handle }}" aria-label="{{ 'products.product.wishlist_text' | t }}" aria-pressed="false">
                        {%- include 'icon-heart' -%}
                      </button>
                    {% endif %}
                  </div>
                  <div class="gb3-product-meta">
                    {% assign gb3_variant_label = product.selected_or_first_available_variant.option1 | strip %}
                    {% if product.has_only_default_variant or gb3_variant_label == blank or gb3_variant_label == 'Default Title' %}
                      {% assign gb3_variant_label = blank %}
                    {% endif %}
                    {% assign gb3_display_title = product.title %}
                    {% if gb3_variant_label != blank %}
                      {% assign gb3_title_suffix = ' ' | append: gb3_variant_label %}
                      {% assign gb3_title_suffix_slash = ' / ' | append: gb3_variant_label %}
                      {% assign gb3_display_title = gb3_display_title | replace: gb3_title_suffix_slash, '' %}
                      {% assign gb3_display_title = gb3_display_title | replace: gb3_title_suffix, '' %}
                    {% endif %}
                    {% assign gb3_display_title = gb3_display_title | replace: '-', '' | strip %}
                    <p class="gb3-product-title"><a href="{{ product.url | within: cards_collection_obj }}">{{ gb3_display_title }}</a></p>
                    {% if gb3_variant_label != blank %}
                      <div class="gb3-product-variant">{{ gb3_variant_label }}</div>
                    {% endif %}
                    <div class="gb3-product-price">{{ product.price | money }}</div>
                    {% assign gb3_thumb_image = product.selected_or_first_available_variant.image | default: product.featured_image %}
                    {% if gb3_thumb_image != blank %}
                      <div class="gb3-product-thumb-wrap">
                        <span
                          class="gb3-product-thumb"
