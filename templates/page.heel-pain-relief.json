om\/vionicshoesph\/\"><img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0553\/5590\/0092\/files\/icon_instagram_1.webp\" alt=\"Instagram\"><\/a>\n        <\/div>\n    <\/div>\n\n    <script>\n        \/\/ JavaScript for Newsletter Signup Validation and Submission\n        document.getElementById('contact_form').addEventListener('submit', function(event) {\n            var emailInput = document.getElementById('Email');\n            if (!emailInput.value.includes('@')) {\n                alert('Please enter a valid email address.');\n                event.preventDefault();\n            }\n        });\n\n        \/\/ JavaScript for Mobile Newsletter Signup Validation and Submission\n        document.getElementById('mobile-contact_form').addEventListener('submit', function(event) {\n            var emailInput = document.getElementById('mobile-Email');\n            if (!emailInput.value.includes('@')) {\n                alert('Please enter a valid email address.');\n                event.preventDefault();\n            }\n        });\n\n        \/\/ Check URL for 'customer_posted=true' and display thank-you message\n        function checkUrlAndDisplayMessage() {\n            const urlParams = new URLSearchParams(window.location.search);\n            if (urlParams.get('customer_posted') === 'true') {\n                document.getElementById('thank-you-message').style.display = 'block';\n                document.querySelector('.footer-section').scrollIntoView({\n                    behavior: 'smooth' \/\/ Smoothly scroll to the footer section\n                });\n            }\n        }\n\n        function checkMobileUrlAndDisplayMessage() {\n            const urlParams = new URLSearchParams(window.location.search);\n            if (urlParams.get('customer_posted') === 'true') {\n                document.getElementById('mobile-thank-you-message').style.display = 'block';\n                document.querySelector('.mobile-footer').scrollIntoView({\n                    behavior: 'smooth' \/\/ Smoothly scroll to the mobile footer section\n                });\n            }\n        }\n\n        checkUrlAndDisplayMessage();\n        checkMobileUrlAndDisplayMessage();\n    <\/script>\n\n<\/body>","width":"100%","align":"auto"}}},"block_order":["html_VnjrGJ"],"name":"Custom HTML","settings":{"animation":"","paddingsection":"0px 0px 0px 0px","paddingmobile":"0px 0px 0px 0px","marginsection":"0px 0px 0px 0px","marginmobile":"0px 0px 0px 0px","zindex":"0","title_top":"","title":"","des":"","setwidth":"full","padding":false,"col_center":false,"bgsection":"rgba(0,0,0,0)","rangebg":0,"bgbefore":"rgba(0,0,0,0)","e_size":"auto","e_repeat":"no-repeat"}}},"order":["main","grid_banner_eg6DnF","advanced_content_YyNVTp","advanced_content_rBNrNn"]}